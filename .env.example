# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and never committed.
# ---------------------------------------------------------------
BASE_URL=https://agentai-qa.inride.com

# --- browser ---
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=20000
NAVIGATION_TIMEOUT=60000

# --- visual highlighting (see utils/highlight.py) ---
HIGHLIGHT_ENABLED=true
HIGHLIGHT_MS=350
HIGHLIGHT_BACKGROUND=#FFEB3B
HIGHLIGHT_OUTLINE=3px solid #FFC107
HIGHLIGHT_OUTLINE_COLOR=#F57F17
HIGHLIGHT_FOREGROUND=#1A1A1A
FAILURE_OUTLINE=3px solid #E53935
FAILURE_OUTLINE_COLOR=#C62828

# ---------------------------------------------------------------
# Role credentials. Keys are <ROLE>_USERNAME / <ROLE>_PASSWORD and
# are resolved dynamically by config/roles.py - adding a role never
# requires a code change.
# ---------------------------------------------------------------
PLATFORM_ADMIN_USERNAME=individual@yopmail.com
PLATFORM_ADMIN_PASSWORD=

DEALER_ADMIN_USERNAME=arizona.toyota.corp@yopmail.com
DEALER_ADMIN_PASSWORD=

USER_USERNAME=forhad1.inride@yopmail.com
USER_PASSWORD=

READ_ONLY_USER_USERNAME=Scopereadonly@yopmail.com
READ_ONLY_USER_PASSWORD=
